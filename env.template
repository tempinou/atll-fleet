# Réglages de Fleetbase propres à cette instance.
#
# Ce fichier est chargé au démarrage de l'application (et avant chaque tâche
# planifiée). Les variables définies ici PRIMENT sur celles calculées depuis
# les addons Cloudron (base de données, Redis, courriel…). Redémarrer
# l'application après modification.
#
# APP_KEY est générée automatiquement au premier démarrage : ne pas la
# modifier, sinon les données chiffrées deviennent illisibles.

# --- Cartographie / géolocalisation (optionnel)
# GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_LOCALE=fr
# IPINFO_API_KEY=
# OSRM_HOST=https://router.project-osrm.org

# --- SMS via Twilio (optionnel)
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=

# --- Stockage objet S3 à la place du disque local (optionnel)
# FILESYSTEM_DRIVER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AWS_BUCKET=
# AWS_URL=
# AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Origines supplémentaires autorisées en CORS (séparées par des virgules)
# FRONTEND_HOSTS=

# --- Temps réel (SocketCluster) : par défaut, seules les connexions WebSocket
# venant de l'origine de cette application sont acceptées. Les clients qui
# n'envoient pas d'en-tête Origin (applications mobiles natives) sont refusés ;
# pour les autoriser, ouvrir à toutes les origines (garder les guillemets simples) :
# SOCKETCLUSTER_OPTIONS='{"origins":"*:*"}'
