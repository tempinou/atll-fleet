{
  "id": "io.fleetbase.cloudronapp",
  "title": "Fleetbase",
  "tagline": "Plateforme logistique open source : TMS, gestion de flotte et livraison",
  "description": "file://DESCRIPTION.md",
  "changelog": "file://CHANGELOG",
  "version": "0.1.1",
  "upstreamVersion": "0.7.68",
  "manifestVersion": 2,
  "healthCheckPath": "/",
  "httpPort": 8000,
  "website": "https://fleetbase.io",
  "documentationUrl": "https://docs.fleetbase.io",
  "forumUrl": "https://github.com/fleetbase/fleetbase/discussions",
  "packagerName": "DevClics",
  "packagerUrl": "https://github.com/tempinou/atll-fleet",
  "icon": "file://logo.png",
  "iconUrl": "https://raw.githubusercontent.com/tempinou/atll-fleet/main/logo.png",
  "mediaLinks": [
    "https://fleetbase.io/images/screenshots/fleet-ops/fleet-ops-orders-map.webp",
    "https://fleetbase.io/images/screenshots/fleet-ops/fleet-ops-orders-board.webp",
    "https://fleetbase.io/images/screenshots/ledger/ledger-dashboard.webp"
  ],
  "tags": [
    "logistics",
    "fleet",
    "delivery",
    "tms",
    "erp"
  ],
  "memoryLimit": 2147483648,
  "minBoxVersion": "9.1.0",
  "addons": {
    "localstorage": {},
    "mysql": {
      "multipleDatabases": true
    },
    "redis": {},
    "sendmail": {
      "supportsDisplayName": true
    },
    "oidc": {
      "loginRedirectUri": "/int/v1/auth/oauth/cloudron/callback"
    },
    "scheduler": {
      "laravel": {
        "schedule": "* * * * *",
        "command": "/app/code/schedule.sh"
      }
    }
  },
  "optionalSso": true,
  "postInstallMessage": "file://POSTINSTALL.md",
  "configurePath": "/console/admin"
}
